{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "grant-sift",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "run.py",
        "serve",
        "--port",
        "8091"
      ],
      "port": 8091
    },
    {
      "name": "grant-sift-incore",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "run.py",
        "serve",
        "--port",
        "8093"
      ],
      "env": {
        "GRANT_SIFT_PROFILE": "config/profile.incore.yaml",
        "GRANT_SIFT_ROSTER": "config/roster.incore.yaml",
        "GRANT_SIFT_DB": "grant-sift-incore.db"
      },
      "port": 8093
    }
  ]
}
