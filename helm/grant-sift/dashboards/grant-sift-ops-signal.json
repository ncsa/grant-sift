    {
      "title": "Source zero-streak",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 17
      },
      "datasource": {
        "type": "yesoreyeram-infinity-datasource",
        "uid": "grant-sift-stats"
      },
      "targets": [
        {
          "refId": "A",
          "type": "json",
          "source": "url",
          "url": "http://grant-sift:8080/api/stats?metric=source_zero_streak&since_days=90",
          "url_options": {
            "method": "GET"
          },
          "format": "table",
          "root_selector": "rows",
          "columns": [
            {
              "selector": "day",
              "text": "day",
              "type": "timestamp"
            },
            {
              "selector": "dim",
              "text": "source",
              "type": "string"
            },
            {
              "selector": "value",
              "text": "streak",
              "type": "number"
            }
          ]
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "always",
            "pointSize": 4,
            "spanNulls": false,
            "lineInterpolation": "stepAfter",
            "insertNulls": 129600000
          },
          "displayName": "${__field.labels.source}",
          "unit": "none",
          "decimals": 0
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "filterByValue",
          "options": {
            "type": "include",
            "match": "any",
            "filters": [
              {
                "fieldName": "streak",
                "config": {
                  "id": "greater",
                  "options": {
                    "value": 0
                  }
                }
              }
            ]
          }
        },
        {
          "id": "partitionByValues",
          "options": {
            "fields": [
              "source"
            ],
            "keepFields": false
          }
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "sortBy": "Last *",
          "sortDesc": true,
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Consecutive ingest runs with zero results, per source. Only sources with a streak > 0 are drawn."
    }
